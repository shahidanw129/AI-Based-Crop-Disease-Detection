SECRET_KEY=replace-with-a-long-random-value
# Enable only when the site is served over HTTPS; leave unset for localhost.
# COOKIE_SECURE=1
# Set these to enable password-reset email delivery.
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-account
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=Fieldnote AI <no-reply@example.com>
# SQLite is used by default. For MySQL, install PyMySQL and set:
# DATABASE_URL=mysql+pymysql://user:password@localhost/SmartFarmingDB
# WEATHER_TIMEOUT_SECONDS=8
# Optional fallback model paths; an active database model takes precedence.
# MODEL_PATH=models/experiments/mobilenetv2_transfer_v1/best_model.keras
# LABELS_PATH=models/experiments/mobilenetv2_transfer_v1/class_names.json